{
    "extends": "@tsconfig/node22/tsconfig.json",
    "include": ["vite.config.*", "vitest.config.*", "vitest-setup.ts", "json-schema-to-types.ts"],
    "compilerOptions": {
        "composite": true,
        "noEmit": true,
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",

        "module": "ESNext",
        "moduleResolution": "Bundler",
        "types": ["node"]
    }
}
